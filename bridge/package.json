{
  "name": "talky-bridge",
  "version": "0.5.0",
  "description": "Receives LibertyTalk webhooks and turns them into jobs for the Talky mod of Project Zomboid, on the player's PC or next to a game server.",
  "private": true,
  "license": "MIT",
  "author": "Tech Liberty",
  "homepage": "https://github.com/Tech-Liberty/talky-project-zomboid",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tech-Liberty/talky-project-zomboid.git"
  },
  "main": "bridge.js",
  "bin": {
    "talky-bridge": "bridge.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bridge.js",
    "server": "node bridge.js --server",
    "fire": "node bridge.js fire",
    "url": "node bridge.js url",
    "new-token": "node bridge.js new-token",
    "test": "node test/run-tests.mjs"
  }
}
